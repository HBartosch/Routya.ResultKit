<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net7.0;net8.0;net9.0</TargetFrameworks>
    <LangVersion>11.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Title>Routya.ResultKit.AspNetCore</Title>
    <Authors>Henry Bartosch</Authors>
    <PackageId>Routya.ResultKit.AspNetCore</PackageId>
    <Version>2.0.0</Version>
    <RepositoryUrl>https://github.com/HBartosch/Routya.ResultKit</RepositoryUrl>
    <PackageProjectUrl>https://github.com/HBartosch/Routya.ResultKit</PackageProjectUrl>
    <PackageTags>result;aspnetcore;problem-details;rfc7807;middleware;exception-handling;minimal-api;iresult;resultkit;Routya</PackageTags>
    <Description>ASP.NET Core integration for Routya.ResultKit with Microsoft ProblemDetails support, exception handling middleware, and IResult/IActionResult extensions.</Description>
    <PackageIcon>PackageIconResized.png</PackageIcon>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Routya.ResultKit\Routya.ResultKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\Routya.ResultKit\PackageIconResized.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
