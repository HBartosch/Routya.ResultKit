<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
	  <LangVersion>9.0</LangVersion>
	  <SignAssembly>False</SignAssembly>
	  <Title>Routya.ResultKit</Title>
	  <Authors>Henry Bartosch</Authors>
	  <PackageId>Routya.ResultKit</PackageId>
	  <Version>2.1.0</Version>
	  <RepositoryUrl>https://github.com/HBartosch/Routya.ResultKit</RepositoryUrl>
	  <PackageProjectUrl>https://routya.github.io/</PackageProjectUrl>
	  <PackageTags>result;validation;model validation;data-annotations;system.componentmodel.dataannotations;nested validation;fluent validation;error-handling;response-wrapper;transforming;mapping;resultkit;Routya;rfc7807;problem-details</PackageTags>
	  <Description>Lightweight result wrapper, validation and transformation toolkit for C# APIs with RFC 7807 Problem Details support. Includes Result, ProblemDetails, and powerful custom validation attributes.</Description>
	  <PackageIcon>PackageIconResized.png</PackageIcon>
	  <PackageLicenseFile>LICENSE</PackageLicenseFile>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageReleaseNotes>v2.1.0: Added NoContent() for 204 responses and Redirect()/RedirectPermanent() for 301/302 redirects. Includes automatic status code handling.</PackageReleaseNotes>
	  <RepositoryType>git</RepositoryType>
	  <Copyright>Copyright (c) 2025 Henry Bartosch</Copyright>
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Routya.ResultKit.AspNetCore" />
  </ItemGroup>
	
  <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
  	<Nullable>enable</Nullable>
  </PropertyGroup>	

  <ItemGroup>
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
  	<None Include="..\LICENSE" Pack="true" PackagePath="" />
  	<None Include="..\README.md" Pack="true" PackagePath="" />
	<None Include="PackageIconResized.png" Pack="true" PackagePath="" />
	<None Include="..\docs\MIGRATION_V2.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>

</Project>
